  "config": {
    "target": "hud",
    "statusName": "HUD",
    "socketPath": "/dev/shm/cluster-render/render.sock",
    "location": {
      "lat": 37.1436,
      "lon": 42.6827
    },
    "utcOffsetMinutes": 180,
    "_comment": "socketPath: cluster-render's documented default. location: where the Auto theme works out sunrise and sunset (Charlotte, NC). utcOffsetMinutes: leave null to use the head unit's own time zone; set it (e.g. -300 for EST) only if the HUD clock shows the wrong hour on the car. tankLitres: the fuel gauge's full mark (the car sends litres, not the tank size; a G01 X3 holds 65).",
    "dme": {
      "comment": "Boost from the engine unit (DME, ecu 18) over read-only UDS 0x22, only while the sport display sends no boost and a boost readout is shown. Absolute kPa, the outside air pressure (baro) is subtracted. Candidates tried in order, the first plausible one wins. From cauliflowermossgrape's car_vitals (MIT). Intake air temperature the same way (config.dme.intake, every 2 s, only while an intake readout shows); candidates from cruzen991/Cluster's signal table (MIT), unverified on this car.",
      "ecu": 18,
      "boost": [
        {
          "did": "F470",
          "bytes": 2,
          "at": 3,
          "factor": 0.03125,
          "offset": 0,
          "min": 20,
          "max": 600,
          "note": "OBD PID 0x70 boost pressure control: actual boost pressure sensor A (absolute), 1/32 kPa"
        },
        {
          "did": "F487",
          "bytes": 2,
          "at": 1,
          "factor": 0.03125,
          "offset": 0,
          "min": 20,
          "max": 600,
          "note": "OBD PID 0x87 intake manifold absolute pressure sensor A, 1/32 kPa"
        },
        {
          "did": "F40B",
          "bytes": 1,
          "at": 0,
          "factor": 1,
          "offset": 0,
          "min": 20,
          "max": 255,
          "note": "OBD PID 0x0B intake manifold absolute pressure, kPa (max 255 = 1.5 bar boost)"
        },
        {
          "obd": "0B",
          "bytes": 1,
          "at": 0,
          "factor": 1,
          "offset": 0,
          "min": 20,
          "max": 255,
          "note": "OBD service 01 PID 0x0B (same as F40B)"
        }
      ],
      "baro": [
        {
          "did": "F433",
          "bytes": 1,
          "at": 0,
          "factor": 1,
          "offset": 0,
          "min": 50,
          "max": 115,
          "note": "OBD PID 0x33 barometric pressure, kPa (101.3 when not available)"
        },
        {
          "obd": "33",
          "bytes": 1,
          "at": 0,
          "factor": 1,
          "offset": 0,
          "min": 50,
          "max": 115,
          "note": "OBD service 01 PID 0x33 (same as F433)"
        }
      ],
      "intake": [
        {
          "did": "F40F",
          "bytes": 1,
          "at": 0,
          "factor": 1,
          "offset": -40,
          "min": -35,
          "max": 150,
          "note": "OBD PID 0x0F intake air temperature, C + 40"
        },
        {
          "did": "F477",
          "bytes": 1,
          "at": 1,
          "factor": 1,
          "offset": -40,
          "min": -35,
          "max": 150,
          "note": "OBD PID 0x77 charge air cooler temperature, bank 1 sensor 1 (byte after the support byte), C + 40"
        },
        {
          "obd": "0F",
          "bytes": 1,
          "at": 0,
          "factor": 1,
          "offset": -40,
          "min": -35,
          "max": 150,
          "note": "OBD service 01 PID 0x0F (same as F40F)"
        }
      ]
    },
    "tankLitres": 65
  }
